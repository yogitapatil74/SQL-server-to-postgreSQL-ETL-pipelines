# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── SQL Server (source) ───────────────────────────────────────────────
# Windows auth:   ...;Trusted_Connection=yes;...
# SQL auth:       ...;UID=user;PWD=password;...
# Linux/macOS: install "ODBC Driver 18 for SQL Server" and use that name.
SQLSERVER_CONN="DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=AdventureWorks2022;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes"
SQLSERVER_TIMEOUT=30

# ── PostgreSQL (destination) ──────────────────────────────────────────
POSTGRESQL_HOSTNAME=localhost
POSTGRESQL_PORT=5432
# Administrative database used for CREATE/DROP DATABASE
POSTGRES_DB_NAME=postgres
POSTGRES_DB_USERNAME=postgres
POSTGRES_DB_PASSWORD=change-me

# Application role created by the pipeline (letters, digits, underscores)
DB_ROLE=etl_user
DB_ROLE_PASSWORD=change-me-too

# ── Optional overrides (defaults are relative to the repository) ──────
# SQL_PATH=./sql
# LOGS_PATH=./logs
# INSERT_PAGE_SIZE=1000
LOG_LEVEL=INFO
